# =============================================================================
# Madd Hatter Sync — .gitignore
# =============================================================================

# ---- Logs -------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Dependencies -----------------------------------------------------------
node_modules

# ---- Build outputs ----------------------------------------------------------
dist
dist-ssr
build

# ---- TanStack / Nitro / Vinxi generated outputs ----------------------------
.output
.vinxi
.tanstack/**
.nitro

# ---- Vite cache -------------------------------------------------------------
.vite

# ---- Environment / Secrets --------------------------------------------------
# NEVER commit real secrets. Keep .env.example committed.
.env
.env.*
!.env.example

# ---- Wrangler / Cloudflare --------------------------------------------------
.wrangler/
.dev.vars

# ---- Tailwind generated config (AI Studio-specific) ------------------------
# This file is generated by the AI Studio vibe plugin and is not needed for
# local development or standard Tailwind v4 builds.
src/tailwind.config.vibe.json

# ---- vibe/ directory --------------------------------------------------------
# vibe/project.json identifies this as a TanStack Start template for AI Studio
# and is COMMITTED intentionally so AI Studio can recognise the project type.
# If AI Studio regenerates other vibe artefacts in this directory, add them here:
# vibe/some-generated-file.json

# ---- Misc editor / OS files -------------------------------------------------
*.local
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Coverage / test outputs ------------------------------------------------
coverage
