# =============================================================================
# Madd Hatter Sync — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env or any file containing real secrets.
# =============================================================================

# ---- Supabase ---------------------------------------------------------------
# Project URL — found in Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe for browser use, still required on server for
# client-auth flows.
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Secret (service-role) key — server-only, never expose to the browser.
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ---- Clover POS -------------------------------------------------------------
# Merchant ID from Clover dashboard or developer portal.
CLOVER_MERCHANT_ID=your-clover-merchant-id

# Access token (preferred) or API key for authenticating Clover REST API calls.
CLOVER_ACCESS_TOKEN=your-clover-access-token
# Legacy alias — only needed if using older CLOVER_API_KEY convention:
# CLOVER_API_KEY=your-clover-api-key

# Optional: set to "sandbox" to use apisandbox.dev.clover.com instead of
# the production API host. Defaults to "production".
# CLOVER_ENVIRONMENT=production

# Optional: override the IANA timezone used for Clover date range queries.
# Defaults to "America/New_York".
# CLOVER_TIMEZONE=America/New_York

# ---- GoHighLevel (GHL) ------------------------------------------------------
# Location ID for the GHL sub-account.
GHL_LOCATION_ID=your-ghl-location-id

# Private Integration Token (PIT) for the GHL location.
GHL_PIT_TOKEN=your-ghl-pit-token

# Optional: custom object schema key / object ID for "POS Purchase Item".
# Defaults to 6aad9f812c282b1dfcb1c1b8 if not set.
# GHL_PURCHASE_OBJECT_SCHEMA_KEY=6aad9f812c282b1dfcb1c1b8

# Legacy alias (same purpose as GHL_PURCHASE_OBJECT_SCHEMA_KEY):
# GHL_CUSTOM_OBJECT_ID=6aad9f812c282b1dfcb1c1b8
