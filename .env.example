# ── Supabase ──────────────────────────────────────────────
# Found in your Supabase project settings.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Browser/client key (safe to expose to the frontend bundle).
SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
# Server-only key. NEVER expose to the browser.
SUPABASE_SECRET_KEY=eyJhbGci...

# ── Clover (Production) ───────────────────────────────────
# Merchant ID from the Clover Developer App REST configuration.
CLOVER_MERCHANT_ID=TBB8RGKQHGTX1
# Merchant API token (Bearer). Server-only.
CLOVER_ACCESS_TOKEN=...
# Base URL. Production: https://api.clover.com  Sandbox: https://apisandbox.dev.clover.com
CLOVER_API_BASE_URL=https://api.clover.com

# ── GoHighLevel / CRM ─────────────────────────────────────
# Sub-account Private Integration Token (Bearer). Server-only.
GHL_PIT_TOKEN=pit-...
# Sub-account / location ID.
GHL_LOCATION_ID=7biYjalPZzmmvKaLw0WN

# ── Automatic sync ────────────────────────────────────────
# Random secret that protects the cron trigger
# (GET /api/sync?secret=...). Generate with: openssl rand -hex 32
SYNC_SECRET=replace-with-a-long-random-string

# Optional dedicated secret for the customer-backfill cron endpoint. If unset,
# falls back to SYNC_SECRET. (GET /api/sync/historical-customers?secret=...)
SYNC_BACKFILL_SECRET=

# Optional HMAC secret from the Clover Dashboard → Developers → Webhooks
# configuration. When set, inbound POST /api/sync payloads are verified
# via X-Clover-Webhook-Signature. Leave blank to skip verification (not
# recommended for production).
CLOVER_WEBHOOK_SECRET=

# Set to 'true' in production to HARD-REJECT unsigned webhook POST requests
# when CLOVER_WEBHOOK_SECRET is absent. Prevents unauthenticated callers from
# triggering sync operations. Leave unset (or 'false') in dev/sandbox.
CLOVER_WEBHOOK_REQUIRE_SECRET=

# ── Batch throughput ──────────────────────────────────────
# Number of orders (step=push) or stranded customers (step=backfill) processed
# per cron tick. The loop is hard time-boxed to ~22s regardless of this value,
# so you can safely raise it to 100 during a backlog drain. Default 10.
SYNC_BATCH_LIMIT=10

